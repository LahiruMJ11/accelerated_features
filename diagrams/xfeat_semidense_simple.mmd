%% Slide diagram: semi-dense matching with XFeat*.
%% Coarse means a lower-resolution grid, with a step of about 8 input pixels.
%% The paper uses two image scales: 0.65 and 1.3; the refactored repo uses 0.6 and 1.3.
%% Refinement predicts a within-cell offset and filters low-confidence matches.
%% Counts and confidence threshold follow the paper's evaluation setup.
%% 10,000 is the combined feature limit per image across scales, not a match count.
%% MLP = multilayer perceptron; MNN = mutual nearest-neighbor.
%% Wide, shallow boxes in a vertical flow leave room for explanations beside the diagram.
%% SVG text avoids renderer-specific HTML label width limits.
%%{init: {"theme":"base","htmlLabels":false,"themeVariables":{"fontFamily":"Arial","fontSize":"24px","primaryTextColor":"#142735","lineColor":"#64748b"},"flowchart":{"htmlLabels":false,"curve":"linear","nodeSpacing":40,"rankSpacing":26,"padding":20,"diagramPadding":16,"wrappingWidth":460,"minNodeWidth":360}}}%%
flowchart TB
    A["Two images through XFeat at two scales"] --> B["Select reliable 64-D coarse features<br/>H/8 × W/8 grids<br/>Keep up to 10,000 per image"]
    B --> C["Mutual nearest-neighbor (MNN) matching<br/>Both descriptors choose each other"]
    C --> D["MLP refinement: offset inside an 8 × 8 cell<br/>Keep matches with confidence > 0.2"]
    D --> E["Semi-dense matches"]

    classDef input fill:#f1f5f9,stroke:#64748b,color:#142735,stroke-width:2px;
    classDef step fill:#eef0ff,stroke:#6262b8,color:#142735,stroke-width:2px;
    classDef output fill:#6262b8,stroke:#6262b8,color:#ffffff,stroke-width:2px;
    class A input;
    class B,C,D step;
    class E output;
